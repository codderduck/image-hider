{
  "manifest_version": 3,
  "name": "Image Hider",
  "version": "1.3.3",
  "description": "Make the images on your website disappear. A privacy and data-saving tool.",
  "minimum_chrome_version": "101",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "declarativeNetRequest", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Image Hider",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
